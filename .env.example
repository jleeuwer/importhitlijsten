# Hitlijst samenstellen HL-1
NODE_ENV=development
PORT=3020
SHELL_MODE=true
LOG_LEVEL=info
LOG_DIR=logs

# PostgreSQL via Docker host mapping on the Mac/host machine.
# Adjust user/password/database to your local setup.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/musicdb

# Vite dev frontend
VITE_DEV_PORT=5175
# Must match the backend URL. Prevents Vite 502 Bad Gateway when PORT changes.
VITE_API_PROXY_TARGET=http://localhost:3020
# Optional. Leave empty during Vite proxy usage.
# VITE_API_BASE_URL=http://localhost:3020

# Docker migration settings; local psql is not required.
DB_EXEC_MODE=docker
DB_CONTAINER=my-postgresdb
DB_NAME=musicdb
DB_USER=postgres

# Optional report logos. Files under public/ are served from the site root.
REPORT_LOGO_LEFT=/images/reports/logo-left.png
REPORT_LOGO_RIGHT=/images/reports/logo-right.png
